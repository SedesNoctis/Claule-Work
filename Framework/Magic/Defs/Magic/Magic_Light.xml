        <glowRadius>6</glowRadius>
        <glowColor>(220,240,255,0)</glowColor>
      </li>
    </comps>
  </ThingDef>
  <ThingDef ParentName="BuildingBase">
    <defName>Avir_LightCrystalStore</defName>
    <label>light crystal</label>
    <description>A crystal raised by a mage of the Crystal: Light feeds on itself in it, and it shines at all hours for about five days, with no power. Its colour can be changed. A reflector too: it answers every spell of Light at a steady share of its strength and never loses focus.</description>
    <thingClass>Avir.Magic.Building_LightReflector</thingClass>
    <graphicData>
      <texPath>Things/Mote/Avir/Magic/Light/Crystal</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>Transparent</shaderType>
      <drawSize>(1.5,1.5)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <rotatable>false</rotatable>
    <tickerType>Normal</tickerType>
    <selectable>true</selectable>
    <useHitPoints>true</useHitPoints>
    <blockLight>false</blockLight>
    <statBases>
      <MaxHitPoints>150</MaxHitPoints>
      <Flammability>0</Flammability>
    </statBases>
    <size>(1,1)</size>
    <building>
      <isInert>true</isInert>
      <claimable>false</claimable>
      <deconstructible>true</deconstructible>
      <expandHomeArea>false</expandHomeArea>
      <ai_chillDestination>false</ai_chillDestination>
    </building>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>9</glowRadius>
        <glowColor>(220,240,255,0)</glowColor>
        <colorPickerEnabled>true</colorPickerEnabled>
      </li>
    </comps>
  </ThingDef>
  <ThingDef ParentName="BuildingBase">
    <defName>Avir_LightCrystalSun</defName>
    <label>sun crystal</label>
    <description>A crystal raised by a mage of the Crystal: it burns by day like a sun lamp - plants grow under it - and goes out at night, for about five days, with no power. Its colour can be changed. A reflector too, answering every spell of Light at a steady share.</description>
    <thingClass>Avir.Magic.Building_LightReflector</thingClass>
    <graphicData>
      <texPath>Things/Mote/Avir/Magic/Light/Crystal</texPath>
      <graphicClass>Graphic_Single</graphicClass>
