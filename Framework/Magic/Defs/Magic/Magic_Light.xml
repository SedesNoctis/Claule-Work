<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Pure Light (Fix202): reflectors, the light's dazzle, the blind patches of Withering. -->
  <ThingDef ParentName="BuildingBase">
    <defName>Avir_LightReflector</defName>
    <label>reflector of light</label>
    <description>A shard of light standing in the air, raised by a cast of Light. While it burns it lights the ground round it, and every spell of Light its caster lets go within reach is sent back from it into the point once more, weaker. It can be broken - and the foes know it.</description>
    <thingClass>Avir.Magic.Building_LightReflector</thingClass>
    <graphicData>
      <texPath>Things/Mote/Avir/Magic/Light/Reflector</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>MoteGlow</shaderType>
      <drawSize>(1.3,1.3)</drawSize>
    </graphicData>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <passability>Standable</passability>
    <rotatable>false</rotatable>
    <tickerType>Normal</tickerType>
    <selectable>true</selectable>
    <useHitPoints>true</useHitPoints>
    <drawerType>RealtimeOnly</drawerType>
    <blockLight>false</blockLight>
    <statBases>
      <MaxHitPoints>35</MaxHitPoints>
      <Flammability>0</Flammability>
    </statBases>
    <size>(1,1)</size>
    <building>
      <isInert>true</isInert>
      <claimable>false</claimable>
      <deconstructible>false</deconstructible>
      <expandHomeArea>false</expandHomeArea>
      <ai_chillDestination>false</ai_chillDestination>
    </building>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>7</glowRadius>
        <glowColor>(255,238,190,0)</glowColor>
      </li>
    </comps>
  </ThingDef>

  <HediffDef>
    <defName>Avir_LightDazzle</defName>
    <label>dazzled by light</label>
    <description>Light struck straight into the eyes. Other magic only clouds the sight; Light can take it away altogether for a while. It clears by itself.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(1, 0.93, 0.68)</defaultLabelColor>
    <isBad>true</isBad>
    <initialSeverity>0.01</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-40</severityPerDay>
      </li>
      <li Class="Avir.Magic.HediffCompProperties_SpellMotes">
        <kind>stars</kind>
        <color>(1, 0.95, 0.75, 0.6)</color>
        <interval>30</interval>
        <scale>0.7</scale>
        <height>0.5</height>
      </li>
    </comps>
    <stages>
      <li>
        <label>dazzled</label>
        <capMods><li><capacity>Sight</capacity><offset>-0.3</offset></li></capMods>
        <statOffsets><ShootingAccuracyPawn>-0.2</ShootingAccuracyPawn></statOffsets>
      </li>
      <li>
        <minSeverity>0.35</minSeverity>
        <label>blinded by light</label>
        <capMods><li><capacity>Sight</capacity><offset>-0.6</offset></li></capMods>
        <statOffsets><ShootingAccuracyPawn>-0.45</ShootingAccuracyPawn><MeleeHitChance>-0.15</MeleeHitChance></statOffsets>
      </li>
      <li>
        <minSeverity>0.7</minSeverity>
        <label>light-blind</label>
        <capMods><li><capacity>Sight</capacity><setMax>0.05</setMax></li></capMods>
        <statOffsets><ShootingAccuracyPawn>-0.8</ShootingAccuracyPawn><MeleeHitChance>-0.4</MeleeHitChance></statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>Avir_LightBlindZone</defName>
    <label>in a blind patch</label>
    <description>Standing where Light was taken away: no lamp and no sun reaches here. Whoever cannot see in the dark can barely aim.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.55, 0.55, 0.7)</defaultLabelColor>
    <isBad>true</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>120~120</disappearsAfterTicks>
      </li>
    </comps>
    <stages>
      <li>
        <statOffsets><ShootingAccuracyPawn>-0.7</ShootingAccuracyPawn></statOffsets>
      </li>
    </stages>
  </HediffDef>

  <DamageDef>
    <defName>Avir_LightSear</defName>
    <label>searing light</label>
    <workerClass>DamageWorker_AddInjury</workerClass>
    <externalViolence>true</externalViolence>
    <deathMessage>{0} has been seared to death by light.</deathMessage>
    <hediff>Avir_LightBurn</hediff>
    <harmsHealth>true</harmsHealth>
    <defaultDamage>6</defaultDamage>
    <armorCategory>Heat</armorCategory>
  </DamageDef>
  <HediffDef ParentName="InjuryBase">
    <defName>Avir_LightBurn</defName>
    <label>light burn</label>
    <labelNoun>a burn of light</labelNoun>
    <description>Skin seared where light struck it: shallow, bright-edged, quick to blister.</description>
    <comps>
      <li Class="HediffCompProperties_TendDuration"><labelTendedWell>bandaged</labelTendedWell><labelTendedWellInner>tended</labelTendedWellInner><labelSolidTendedWell>tended</labelSolidTendedWell></li>
      <li Class="HediffCompProperties_Infecter"><infectionChance>0.1</infectionChance></li>
      <li Class="HediffCompProperties_GetsPermanent"><permanentLabel>light scar</permanentLabel></li>
    </comps>
    <injuryProps><painPerSeverity>0.0175</painPerSeverity><averagePainPerSeverityPermanent>0.00625</averagePainPerSeverityPermanent><canMerge>true</canMerge><destroyedLabel>burned away</destroyedLabel></injuryProps>
  </HediffDef>
</Defs>
