  <HediffDef>
    <defName>Avir_LightWard</defName>
    <label>ward of light</label>
    <description>A shell of light over the body; whoever wears it carries light round them. Magic of other elements is not put out but sent back the way it came, at the cost of its charge: a flying spell flies home, a blow goes back along the line to whoever struck. Light's own passes it, stronger, and the ward falls.</description>
    <hediffClass>Avir.Magic.Hediff_SpellWard</hediffClass>
    <defaultLabelColor>(1, 0.93, 0.68)</defaultLabelColor>
    <isBad>false</isBad>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>12000~12000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
      <li Class="Avir.Magic.HediffCompProperties_LightGlow" />
    </comps>
  </HediffDef>

  <ThingDef ParentName="BuildingBase">
    <defName>Avir_LightCrystal</defName>
    <label>crystal of light</label>
    <description>A reflector grown by Light meeting Earth: a crystal, sturdier than a shard of light - it does not burn and stands against blasts. It sends every spell of Light back into the point at three quarters of the cast before, and its facets may send it twice. When it breaks, its shards cut whoever stands close.</description>
    <thingClass>Avir.Magic.Building_LightReflector</thingClass>
    <graphicData>
      <texPath>Things/Mote/Avir/Magic/Light/Crystal</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>Transparent</shaderType>
      <drawSize>(1.5,1.5)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Standable</passability>
    <rotatable>false</rotatable>
    <tickerType>Normal</tickerType>
    <selectable>true</selectable>
    <useHitPoints>true</useHitPoints>
    <blockLight>false</blockLight>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <Flammability>0</Flammability>
    </statBases>
    <size>(1,1)</size>
    <building>
      <isInert>true</isInert>
      <claimable>false</claimable>
      <deconstructible>false</deconstructible>
      <expandHomeArea>false</expandHomeArea>
      <ai_chillDestination>false</ai_chillDestination>
    </building>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>6</glowRadius>
        <glowColor>(220,240,255,0)</glowColor>
      </li>
    </comps>
  </ThingDef>
  <ThingDef ParentName="BuildingBase">
    <defName>Avir_LightCrystalUnstable</defName>
    <label>unstable crystal</label>
    <description>A crystal grown too fast, along a ray or out of a burst. It answers the next spell of Light once - and bursts into shards that cut whoever stands close.</description>
    <thingClass>Avir.Magic.Building_LightReflector</thingClass>
    <graphicData>
      <texPath>Things/Mote/Avir/Magic/Light/Crystal</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>Transparent</shaderType>
      <drawSize>(1.2,1.2)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Standable</passability>
    <rotatable>false</rotatable>
    <tickerType>Normal</tickerType>
    <selectable>true</selectable>
    <useHitPoints>true</useHitPoints>
    <blockLight>false</blockLight>
    <statBases>
      <MaxHitPoints>40</MaxHitPoints>
      <Flammability>0</Flammability>
    </statBases>
    <size>(1,1)</size>
    <building>
      <isInert>true</isInert>
      <claimable>false</claimable>
      <deconstructible>false</deconstructible>
      <expandHomeArea>false</expandHomeArea>
      <ai_chillDestination>false</ai_chillDestination>
    </building>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>4</glowRadius>
        <glowColor>(220,240,255,0)</glowColor>
      </li>
    </comps>
  </ThingDef>
  <ThingDef ParentName="BuildingBase">
    <defName>Avir_LightCrystalCage</defName>
    <label>crystal of a cage</label>
    <description>A crystal grown round someone held by Light and Earth: nothing passes it. A reflector too, while it stands.</description>
    <thingClass>Avir.Magic.Building_LightReflector</thingClass>
    <graphicData>
      <texPath>Things/Mote/Avir/Magic/Light/Crystal</texPath>
