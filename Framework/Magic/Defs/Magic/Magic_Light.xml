        <glowColor>(220,240,255,0)</glowColor>
        <overlightRadius>7.9</overlightRadius>
        <colorPickerEnabled>true</colorPickerEnabled>
      </li>
    </comps>
  </ThingDef>
  <HediffDef>
    <defName>Avir_CrystalWard</defName>
    <label>ward of crystal</label>
    <description>A ring of light and crystal over the body. Magic of other elements is not put out but sent back the way it came, at the cost of its charge; the shards of crystals do not pass it at all. Light's own passes it, stronger, and the ward falls.</description>
    <hediffClass>Avir.Magic.Hediff_SpellWard</hediffClass>
    <defaultLabelColor>(0.85, 0.95, 1)</defaultLabelColor>
    <isBad>false</isBad>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>12000~12000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
      <li Class="Avir.Magic.HediffCompProperties_LightGlow" />
    </comps>
  </HediffDef>

  <HediffDef>
    <defName>Avir_LightVigor</defName>
    <label>strength of light</label>
    <description>Light gave the body its strength back: tiredness comes slower, the step is lighter.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(1, 0.95, 0.7)</defaultLabelColor>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>7500~7500</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <restFallFactor>0.6</restFallFactor>
        <capMods><li><capacity>Moving</capacity><offset>0.06</offset></li></capMods>
      </li>
    </stages>
  </HediffDef>

  <DamageDef>
    <defName>Avir_CrystalShard</defName>
    <label>crystal shards</label>
    <workerClass>DamageWorker_AddInjury</workerClass>
    <externalViolence>true</externalViolence>
    <deathMessage>{0} has been cut to pieces by crystal shards.</deathMessage>
    <hediff>Cut</hediff>
    <harmsHealth>true</harmsHealth>
    <defaultDamage>4</defaultDamage>
    <armorCategory>Sharp</armorCategory>
    <isExplosive>true</isExplosive>
    <explosionCellFleck>BlastDry</explosionCellFleck>
    <explosionColorCenter>(0.9, 0.97, 1)</explosionColorCenter>
    <explosionColorEdge>(0.6, 0.78, 0.95)</explosionColorEdge>
    <soundExplosion>Explosion_Bomb</soundExplosion>
    <explosionHeatEnergyPerCell>0</explosionHeatEnergyPerCell>
  </DamageDef>

