        <statOffsets><MeleeDodgeChance>-0.15</MeleeDodgeChance></statOffsets>
      </li>
    </stages>
  </HediffDef>
  <HediffDef>
    <defName>Avir_ZenithSeal</defName>
    <label>seal of the Zenith</label>
