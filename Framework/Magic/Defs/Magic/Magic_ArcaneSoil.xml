<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- ARCANE SOIL: what the bog (water + earth) makes of the ground (Source/Avir/Magic/ArcaneOrders.cs, Enrich), and later the
       ground of the Twilight Marshes and the Jungles. Placeholder textures: vanilla soil, tinted damp and green, until the art comes
       (Промпты-Арканная-почва.md); then point texturePath at Terrain/Surfaces/Avir_ArcaneSoil... and drop the color. -->
  <TerrainDef ParentName="NaturalTerrainBase">
    <defName>Avir_ArcaneSoil</defName>
    <label>arcane soil</label>
    <description>Soil steeped in arcane water and earth: dark, soft and damp, smelling of bog. Plants take to it better than to plain soil. It is the ground of the twilight marshes and jungles.</description>
    <texturePath>Terrain/Surfaces/Soil</texturePath>
    <pollutedTexturePath>Terrain/Surfaces/SoilPolluted</pollutedTexturePath>
    <color>(0.72, 0.82, 0.74)</color>
    <edgeType>FadeRough</edgeType>
    <categoryType>Soil</categoryType>
    <renderPrecedence>343</renderPrecedence>
    <pathCost>3</pathCost>
    <fertility>1.2</fertility>
    <takeFootprints>true</takeFootprints>
    <generatedFilth>Filth_Dirt</generatedFilth>
    <statBases>
      <Beauty>0</Beauty>
      <BeautyOutdoors>1</BeautyOutdoors>
      <Cleanliness>-1.5</Cleanliness>
    </statBases>
    <affordances><li>Light</li><li>Medium</li><li>Heavy</li><li>GrowSoil</li><li>Diggable</li></affordances>
    <tags><li>Soil</li></tags>
  </TerrainDef>
