<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <JobDef>
    <defName>Avir_CastSpell</defName>
    <driverClass>Avir.Magic.JobDriver_CastSpell</driverClass>
    <reportString>casting a spell.</reportString>
    <casualInterruptible>false</casualInterruptible>
    <playerInterruptible>true</playerInterruptible>
    <suspendable>false</suspendable>
  </JobDef>

  <HediffDef>
    <defName>Avir_ArcaneWard</defName>
    <label>arcane ward</label>
    <description>A ward of magic laid over the body: blows land softer while it lasts. A spell of the ward's own element passes through it - and stronger.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.62, 0.48, 0.95)</defaultLabelColor>
    <isBad>false</isBad>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>1800~1800</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <statOffsets>
          <ArmorRating_Sharp>0.25</ArmorRating_Sharp>
          <ArmorRating_Blunt>0.2</ArmorRating_Blunt>
          <ArmorRating_Heat>0.25</ArmorRating_Heat>
        </statOffsets>
      </li>
      <li>
        <minSeverity>0.5</minSeverity>
        <label>strong</label>
        <statOffsets>
          <ArmorRating_Sharp>0.5</ArmorRating_Sharp>
          <ArmorRating_Blunt>0.4</ArmorRating_Blunt>
          <ArmorRating_Heat>0.5</ArmorRating_Heat>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <!-- ===== Fire ===== -->
  <HediffDef>
    <defName>Avir_FireWard</defName>
    <label>ward of flame</label>
    <description>A ward woven of flame. Fire does not pass it - at most it puts out what reaches the body.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(1, 0.55, 0.2)</defaultLabelColor>
    <isBad>false</isBad>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>15000~15000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
      <li Class="Avir.Magic.HediffCompProperties_Fireproof" />
    </comps>
    <stages>
      <li>
        <damageFactors>
          <li><damageDef>Flame</damageDef><factor>0</factor></li>
          <li><damageDef>Burn</damageDef><factor>0</factor></li>
        </damageFactors>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>Avir_FireWarmth</defName>
    <label>warmed by fire</label>
    <description>Warmed through by a mage's held fire: the cold bites far less for a while.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(1, 0.7, 0.4)</defaultLabelColor>
    <isBad>false</isBad>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>60000~60000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <statOffsets>
          <ComfyTemperatureMin>-25</ComfyTemperatureMin>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>Avir_StoredHeat</defName>
    <label>stored heat</label>
    <description>Heat taken out of fire and kept. The mage's next fire spell is stronger by it; kept too long, it slowly fades.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(1, 0.5, 0.15)</defaultLabelColor>
    <isBad>false</isBad>
    <initialSeverity>0.01</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-0.5</severityPerDay>
      </li>
    </comps>
  </HediffDef>

  <HediffDef>
    <defName>Avir_FireEnchant</defName>
    <label>burning weapon</label>
    <description>The weapon burns: blows add flame and may set the foe alight; shots may set what they hit on fire.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(1, 0.5, 0.15)</defaultLabelColor>
    <isBad>false</isBad>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>15000~15000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
  </HediffDef>

  <HediffDef>
    <defName>Avir_RagingFlame</defName>
    <label>raging flame</label>
    <description>The mage has lost hold of their fire. For a while flame keeps breaking out around them, and they cannot hold it back.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.9, 0.25, 0.1)</defaultLabelColor>
    <isBad>true</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>1200~1200</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
      <li Class="Avir.Magic.HediffCompProperties_RagingFlame" />
    </comps>
  </HediffDef>

  <ThingDef>
    <defName>Avir_HeldFlame</defName>
    <label>held flame</label>
    <description>Fire held in its place by a mage: it never spreads, it smoulders and warms - and it burns the mage's foes who stand in it.</description>
    <thingClass>Avir.Magic.HeldFlame</thingClass>
    <category>Ethereal</category>
    <tickerType>Normal</tickerType>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <useHitPoints>false</useHitPoints>
    <selectable>false</selectable>
    <drawerType>RealtimeOnly</drawerType>
    <graphicData>
      <texPath>Things/Special/Fire</texPath>
      <graphicClass>Graphic_Flicker</graphicClass>
      <shaderType>TransparentPostLight</shaderType>
    </graphicData>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>5</glowRadius>
        <glowColor>(255,140,60,0)</glowColor>
      </li>
    </comps>
  </ThingDef>

  <ThingDef>
    <defName>Avir_FireWisp</defName>
    <label>fire wisp</label>
    <description>A small spirit of fire called by a mage. It throws flame at their foes until it burns out.</description>
    <thingClass>Avir.Magic.FireWisp</thingClass>
    <category>Ethereal</category>
    <tickerType>Normal</tickerType>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <useHitPoints>false</useHitPoints>
    <selectable>true</selectable>
    <drawerType>RealtimeOnly</drawerType>
    <graphicData>
      <texPath>Things/Special/Fire</texPath>
      <graphicClass>Graphic_Flicker</graphicClass>
      <shaderType>TransparentPostLight</shaderType>
      <drawSize>0.8</drawSize>
    </graphicData>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>6</glowRadius>
        <glowColor>(255,160,70,0)</glowColor>
      </li>
    </comps>
  </ThingDef>
  <!-- spells that fly: a ball of the element, a beam -->
  <ThingDef Name="Avir_SpellBoltBase" Abstract="True">
    <thingClass>Avir.Magic.Projectile_Spell</thingClass>
    <category>Projectile</category>
    <tickerType>Normal</tickerType>
    <altitudeLayer>Projectile</altitudeLayer>
    <useHitPoints>false</useHitPoints>
    <neverMultiSelect>true</neverMultiSelect>
  </ThingDef>
  <ThingDef ParentName="Avir_SpellBoltBase">
    <defName>Avir_SpellBall</defName>
    <label>ball of fire</label>
    <graphicData>
      <texPath>Things/Mote/FireGlow</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>MoteGlow</shaderType>
      <color>(1.0, 0.55, 0.2)</color>
      <drawSize>(1.6, 1.6)</drawSize>
    </graphicData>
    <projectile>
      <damageDef>Flame</damageDef>
      <damageAmountBase>1</damageAmountBase>
      <speed>32</speed>
    </projectile>
  </ThingDef>
  <ThingDef ParentName="Avir_SpellBoltBase">
    <defName>Avir_SpellBeam</defName>
    <label>beam</label>
    <graphicData>
      <texPath>Things/Mote/FireGlow</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>MoteGlow</shaderType>
      <color>(1.0, 0.75, 0.35)</color>
      <drawSize>(0.7, 2.6)</drawSize>
    </graphicData>
    <projectile>
      <damageDef>Flame</damageDef>
      <damageAmountBase>1</damageAmountBase>
      <speed>110</speed>
    </projectile>
  </ThingDef>
  <!-- WATER -->
  <HediffDef>
    <defName>Avir_Soaked</defName>
    <label>soaked</label>
    <description>Soaked through by a mage's water: slower, and hard to set alight.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.45, 0.65, 1)</defaultLabelColor>
    <isBad>true</isBad>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>2500~2500</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <capMods><li><capacity>Moving</capacity><offset>-0.2</offset></li></capMods>
        <damageFactors><li><damageDef>Flame</damageDef><factor>0.5</factor></li></damageFactors>
      </li>
    </stages>
  </HediffDef>
  <HediffDef>
    <defName>Avir_Parched</defName>
    <label>parched</label>
    <description>Water drawn out of the body by a mage: weak, slow and dizzy until it comes back.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.8, 0.7, 0.45)</defaultLabelColor>
    <isBad>true</isBad>
    <initialSeverity>0.01</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay"><severityPerDay>-2</severityPerDay></li>
    </comps>
    <stages>
      <li>
        <capMods>
          <li><capacity>Moving</capacity><offset>-0.15</offset></li>
          <li><capacity>Consciousness</capacity><offset>-0.1</offset></li>
        </capMods>
      </li>
    </stages>
  </HediffDef>
  <HediffDef>
    <defName>Avir_StoredWater</defName>
    <label>drawn water</label>
    <description>Water drawn out and kept. The mage's next water spell is stronger by it; kept too long, it slowly seeps away.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.45, 0.65, 1)</defaultLabelColor>
    <isBad>false</isBad>
    <initialSeverity>0.01</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay"><severityPerDay>-0.5</severityPerDay></li>
    </comps>
  </HediffDef>
  <HediffDef>
    <defName>Avir_WaterWard</defName>
    <label>ward of water</label>
    <description>A skin of water held round the body: fire and burns bite far less, and flames on it go out.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.45, 0.65, 1)</defaultLabelColor>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>10000~10000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <damageFactors>
          <li><damageDef>Flame</damageDef><factor>0.3</factor></li>
          <li><damageDef>Burn</damageDef><factor>0.3</factor></li>
        </damageFactors>
      </li>
    </stages>
  </HediffDef>
  <HediffDef>
    <defName>Avir_WaterEnchant</defName>
    <label>weapon of water</label>
    <description>The weapon is wrapped in water: blows soak the foe and knock them back a step.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.45, 0.65, 1)</defaultLabelColor>
    <isBad>false</isBad>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>15000~15000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
  </HediffDef>
  <HediffDef>
    <defName>Avir_Chilled</defName>
    <label>chilled to the bone</label>
    <description>The mage lost hold of their water and it soaked them through: slower, and the cold bites hard, for a few hours.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.5, 0.6, 0.9)</defaultLabelColor>
    <isBad>true</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>10000~10000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <capMods><li><capacity>Moving</capacity><offset>-0.2</offset></li></capMods>
        <statOffsets><ComfyTemperatureMin>12</ComfyTemperatureMin></statOffsets>
      </li>
    </stages>
  </HediffDef>
  <ThingDef>
    <defName>Avir_HeldWater</defName>
    <label>held water</label>
    <description>Water held in its place by a mage: foes in it are soaked and slowed, and fire will not take here.</description>
    <thingClass>Avir.Magic.HeldWater</thingClass>
    <category>Ethereal</category>
    <tickerType>Normal</tickerType>
    <altitudeLayer>Filth</altitudeLayer>
    <useHitPoints>false</useHitPoints>
    <selectable>false</selectable>
    <drawerType>RealtimeOnly</drawerType>
    <graphicData>
      <texPath>Things/Projectile/Magic/Ball_Water</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>Transparent</shaderType>
      <color>(1, 1, 1, 0.45)</color>
      <drawSize>(1.1, 1.1)</drawSize>
    </graphicData>
  </ThingDef>
  <ThingDef>
    <defName>Avir_WaterSpirit</defName>
    <label>water spirit</label>
    <description>A small spirit of water called by a mage. It throws water at their foes and puts out the fires near it, until it runs dry.</description>
    <thingClass>Avir.Magic.WaterSpirit</thingClass>
    <category>Ethereal</category>
    <tickerType>Normal</tickerType>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <useHitPoints>false</useHitPoints>
    <selectable>true</selectable>
    <drawerType>RealtimeOnly</drawerType>
    <graphicData>
      <texPath>Things/Projectile/Magic/Ball_Water</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>Transparent</shaderType>
      <drawSize>(0.9, 0.9)</drawSize>
    </graphicData>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>4</glowRadius>
        <glowColor>(90,150,255,0)</glowColor>
      </li>
    </comps>
  </ThingDef>
  <HediffDef>
    <defName>Avir_InMist</defName>
    <label>in the mist</label>
    <description>Inside a water mage's tide: slowed, and it is hard to see through the mist to shoot.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.7, 0.8, 1)</defaultLabelColor>
    <isBad>true</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears"><disappearsAfterTicks>90~90</disappearsAfterTicks></li>
    </comps>
    <stages>
      <li>
        <statOffsets><ShootingAccuracyPawn>-0.3</ShootingAccuracyPawn></statOffsets>
      </li>
    </stages>
  </HediffDef>
  <ThingDef>
    <defName>Avir_SpellDash</defName>
    <label>carried by magic</label>
    <thingClass>Avir.Magic.SpellDash</thingClass>
    <category>Ethereal</category>
    <tickerType>Normal</tickerType>
    <altitudeLayer>Skyfaller</altitudeLayer>
    <drawerType>RealtimeOnly</drawerType>
    <useHitPoints>false</useHitPoints>
    <pawnFlyer>
      <flightDurationMin>0.3</flightDurationMin>
      <flightSpeed>16</flightSpeed>
      <heightFactor>0.15</heightFactor>
    </pawnFlyer>
  </ThingDef>
</Defs>
