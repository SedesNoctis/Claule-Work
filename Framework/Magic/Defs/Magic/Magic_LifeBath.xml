<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- The bath of Fever (Fix198) and massage on a medical bed (Fix201). -->
  <JoyKindDef>
    <defName>Avir_Care</defName>
    <label>bodily ease</label>
  </JoyKindDef>

  <ThingDef ParentName="BuildingBase">
    <defName>Avir_BathSteam</defName>
    <label>bath steam</label>
    <description>A light magical steam raised by a caster of Fever: it warms a close room and fills it with steam. In a small room with seats (about ten cells to a source) the colonists come to bathe. A caster of Fever renews it when it runs low.</description>
    <thingClass>Avir.Magic.Building_BathSteam</thingClass>
    <graphicData>
      <texPath>Things/Mote/Avir/Magic/Bog/Bubbles</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>Transparent</shaderType>
      <drawSize>(1.1,1.1)</drawSize>
      <color>(0.95,0.95,1)</color>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <rotatable>false</rotatable>
    <tickerType>Normal</tickerType>
    <useHitPoints>false</useHitPoints>
    <selectable>true</selectable>
    <statBases><Beauty>4</Beauty></statBases>
    <building><isInert>true</isInert><claimable>false</claimable><deconstructible>true</deconstructible><expandHomeArea>false</expandHomeArea></building>
  </ThingDef>
  <DesignationDef>
    <defName>Avir_LifeBathSteam</defName>
    <texturePath>Designations/HarvestPlant</texturePath>
    <targetType>Cell</targetType>
    <designateCancelable>true</designateCancelable>
  </DesignationDef>
  <WorkGiverDef>
    <defName>Avir_LifeBathSteam</defName>
    <label>raise bath steam (Fever)</label>
    <giverClass>Avir.Magic.WorkGiver_LifeBathSteam</giverClass>
    <workType>Avir_MagicWork</workType>
    <verb>raise steam at</verb>
    <gerund>raising bath steam</gerund>
    <priorityInType>4</priorityInType>
    <requiredCapacities><li>Manipulation</li></requiredCapacities>
  </WorkGiverDef>
  <JobDef>
    <defName>Avir_LifeBathSteam</defName>
    <driverClass>Avir.Magic.JobDriver_LifeBathSteam</driverClass>
    <reportString>raising bath steam.</reportString>
  </JobDef>

  <JobDef>
    <defName>Avir_Bathe</defName>
    <driverClass>Avir.Magic.JobDriver_Bathe</driverClass>
    <reportString>steaming in the bath.</reportString>
    <joyDuration>2500</joyDuration>
    <joyKind>Avir_Care</joyKind>
    <joyMaxParticipants>8</joyMaxParticipants>
  </JobDef>
  <JoyGiverDef>
    <defName>Avir_Bathe</defName>
    <giverClass>Avir.Magic.JoyGiver_Bathe</giverClass>
    <baseChance>3</baseChance>
    <jobDef>Avir_Bathe</jobDef>
    <joyKind>Avir_Care</joyKind>
    <requiredCapacities><li>Moving</li></requiredCapacities>
  </JoyGiverDef>

  <JobDef>
    <defName>Avir_LieForCare</defName>
    <driverClass>Avir.Magic.JobDriver_LieForCare</driverClass>
    <reportString>lying on a medical bed, waiting for a massage.</reportString>
    <joyDuration>3000</joyDuration>
    <joyKind>Avir_Care</joyKind>
    <casualInterruptible>true</casualInterruptible>
  </JobDef>
  <JoyGiverDef>
    <defName>Avir_LieForCare</defName>
    <giverClass>Avir.Magic.JoyGiver_LieForCare</giverClass>
    <baseChance>2</baseChance>
    <jobDef>Avir_LieForCare</jobDef>
    <joyKind>Avir_Care</joyKind>
  </JoyGiverDef>
  <WorkGiverDef>
    <defName>Avir_LifeCare</defName>
    <label>massage</label>
    <giverClass>Avir.Magic.WorkGiver_LifeCare</giverClass>
    <workType>Avir_MagicWork</workType>
    <verb>care for</verb>
    <gerund>caring by Life</gerund>
    <priorityInType>36</priorityInType>
    <requiredCapacities><li>Manipulation</li></requiredCapacities>
  </WorkGiverDef>
  <JobDef>
    <defName>Avir_LifeCare</defName>
    <driverClass>Avir.Magic.JobDriver_LifeCare</driverClass>
    <reportString>working over the one on TargetA.</reportString>
  </JobDef>

  <HediffDef>
    <defName>Avir_Bathed</defName>
    <label>steamed</label>
    <description>Fresh from the bath: heat and cold both bear easier for a while, and the body fights its sicknesses better.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <defaultLabelColor>(0.55,0.85,0.55)</defaultLabelColor>
    <comps><li Class="HediffCompProperties_Disappears"><disappearsAfterTicks>60000</disappearsAfterTicks><showRemainingTime>true</showRemainingTime></li></comps>
    <stages><li><statOffsets><ComfyTemperatureMin>-8</ComfyTemperatureMin><ComfyTemperatureMax>8</ComfyTemperatureMax><ImmunityGainSpeed>0.1</ImmunityGainSpeed></statOffsets></li></stages>
  </HediffDef>
  <HediffDef>
    <defName>Avir_LifeCared</defName>
    <label>back worked loose</label>
    <description>A caster of Life kneaded the back loose: the body light, the aches quiet.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <defaultLabelColor>(0.55,0.85,0.55)</defaultLabelColor>
    <comps><li Class="HediffCompProperties_Disappears"><disappearsAfterTicks>45000</disappearsAfterTicks><showRemainingTime>true</showRemainingTime></li></comps>
    <stages><li><painFactor>0.8</painFactor><capMods><li><capacity>Moving</capacity><offset>0.05</offset></li><li><capacity>Manipulation</capacity><offset>0.05</offset></li></capMods></li></stages>
  </HediffDef>
  <ThoughtDef>
    <defName>Avir_LifeCaredFor</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>1.5</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>back worked loose</label><description>A caster of Life worked the knots out of me. I feel new.</description><baseMoodEffect>8</baseMoodEffect></li></stages>
  </ThoughtDef>
  <HediffDef>
    <defName>Avir_StoneMassaged</defName>
    <label>back worked loose</label>
    <description>A caster of earth worked the back loose - kneaded and pressed with smooth stones in the hands. The knots are gone, the body moves easier.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <defaultLabelColor>(0.55,0.85,0.55)</defaultLabelColor>
    <comps><li Class="HediffCompProperties_Disappears"><disappearsAfterTicks>45000</disappearsAfterTicks><showRemainingTime>true</showRemainingTime></li></comps>
    <stages><li><painFactor>0.85</painFactor><capMods><li><capacity>Moving</capacity><offset>0.05</offset></li><li><capacity>Manipulation</capacity><offset>0.04</offset></li></capMods></li></stages>
  </HediffDef>
  <HediffDef>
    <defName>Avir_LifeKinship</defName>
    <label>felt by Life</label>
    <description>A caster of Life reached for this animal, and it felt them back: less wild for a day - easier to tame, easier to teach.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <defaultLabelColor>(0.55,0.85,0.55)</defaultLabelColor>
    <comps><li Class="HediffCompProperties_Disappears"><disappearsAfterTicks>60000</disappearsAfterTicks><showRemainingTime>true</showRemainingTime></li></comps>
    <stages><li><statOffsets><Wildness>-0.25</Wildness></statOffsets></li></stages>
  </HediffDef>
  <!-- Life's own wounds (Fix199): the Fever's beam boils from inside, the Forge's beam heats the bone. -->
  <DamageDef>
    <defName>Avir_InnerBoil</defName>
    <label>inner boil</label>
    <workerClass>DamageWorker_AddInjury</workerClass>
    <externalViolence>true</externalViolence>
    <deathMessage>{0} has boiled from inside.</deathMessage>
    <hediff>Avir_InnerBoilWound</hediff>
    <harmsHealth>true</harmsHealth>
    <defaultDamage>4</defaultDamage>
  </DamageDef>
  <HediffDef ParentName="InjuryBase">
    <defName>Avir_InnerBoilWound</defName>
    <label>boiled from within</label>
    <labelNoun>a scald from within</labelNoun>
    <description>Blistered from inside: the sweat itself boiled in the pores.</description>
    <comps>
      <li Class="HediffCompProperties_TendDuration"><labelTendedWell>dressed</labelTendedWell><labelTendedWellInner>tended</labelTendedWellInner><labelSolidTendedWell>dressed</labelSolidTendedWell></li>
      <li Class="HediffCompProperties_Infecter"><infectionChance>0.2</infectionChance></li>
      <li Class="HediffCompProperties_GetsPermanent"><permanentLabel>blister scar</permanentLabel></li>
    </comps>
    <injuryProps><painPerSeverity>0.0175</painPerSeverity><averagePainPerSeverityPermanent>0.00625</averagePainPerSeverityPermanent><canMerge>true</canMerge><destroyedLabel>boiled away</destroyedLabel></injuryProps>
  </HediffDef>
  <DamageDef>
    <defName>Avir_BoneHeat</defName>
    <label>bone heat</label>
    <workerClass>DamageWorker_AddInjury</workerClass>
    <externalViolence>true</externalViolence>
    <deathMessage>{0}'s bones have burned from within.</deathMessage>
    <hediff>Avir_BoneHeatWound</hediff>
    <harmsHealth>true</harmsHealth>
    <defaultDamage>6</defaultDamage>
  </DamageDef>
  <HediffDef ParentName="InjuryBase">
    <defName>Avir_BoneHeatWound</defName>
    <label>seared bone</label>
    <labelNoun>a bone seared from within</labelNoun>
    <description>The bone itself glowed red: the flesh round it is cooked from the inside out.</description>
    <comps>
      <li Class="HediffCompProperties_TendDuration"><labelTendedWell>set</labelTendedWell><labelTendedWellInner>tended</labelTendedWellInner><labelSolidTendedWell>set</labelSolidTendedWell></li>
      <li Class="HediffCompProperties_GetsPermanent"><permanentLabel>old seared bone</permanentLabel></li>
    </comps>
    <injuryProps><painPerSeverity>0.02</painPerSeverity><averagePainPerSeverityPermanent>0.0075</averagePainPerSeverityPermanent><canMerge>true</canMerge><destroyedLabel>burned through</destroyedLabel></injuryProps>
  </HediffDef>
</Defs>
