<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- LIFE, the first great circle (Source/Avir/Magic/LifeMagic.cs; Магия-правила.md 0.28). -->

  <DamageDef>
    <defName>Avir_Withering</defName>
    <label>withering</label>
    <workerClass>DamageWorker_AddInjury</workerClass>
    <externalViolence>true</externalViolence>
    <deathMessage>{0} has withered away.</deathMessage>
    <hediff>Avir_Withered</hediff>
    <harmAllLayersUntilOutside>true</harmAllLayersUntilOutside>
    <armorCategory>Heat</armorCategory>
    <defaultArmorPenetration>0.6</defaultArmorPenetration>
  </DamageDef>

  <HediffDef ParentName="InjuryBase">
    <defName>Avir_Withered</defName>
    <label>withered</label>
    <labelNoun>a withered wound</labelNoun>
    <description>Flesh drained grey and dry by Life's Withering. What it held went into someone's store of life.</description>
    <comps>
      <li Class="HediffCompProperties_TendDuration">
        <labelTendedWell>bandaged</labelTendedWell>
        <labelTendedWellInner>sutured</labelTendedWellInner>
        <labelSolidTendedWell>set</labelSolidTendedWell>
      </li>
      <li Class="HediffCompProperties_Infecter">
        <infectionChancePerHourUntended>0.01</infectionChancePerHourUntended>
      </li>
      <li Class="HediffCompProperties_GetsPermanent">
        <permanentLabel>withered scar</permanentLabel>
      </li>
    </comps>
    <injuryProps>
      <painPerSeverity>0.0125</painPerSeverity>
      <averagePainPerSeverityPermanent>0.00625</averagePainPerSeverityPermanent>
      <bleedRate>0.02</bleedRate>
      <canMerge>true</canMerge>
      <destroyedLabel>Withered away</destroyedLabel>
    </injuryProps>
  </HediffDef>

  <HediffDef>
    <defName>Avir_Entangled</defName>
    <label>entangled</label>
    <description>Pale vines have grown round the legs: every step tears at them.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.66, 0.82, 0.55)</defaultLabelColor>
    <isBad>true</isBad>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>480~480</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <capMods>
          <li><capacity>Moving</capacity><offset>-0.6</offset></li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>Avir_LifeRegen</defName>
    <label>life's regrowth</label>
    <description>What Life's mending leaves behind. Every mending deepens it, and it fades by a quarter a day. Light, it quickens healing; deep, it walks old scars down to nothing; saturated, it grows back what was lost - a limb a layer at a time, the organs on a long clock, chronic ailments on a shorter one. It asks nothing of the healed.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.66, 0.82, 0.55)</defaultLabelColor>
    <isBad>false</isBad>
    <initialSeverity>0.01</initialSeverity>
    <maxSeverity>1.5</maxSeverity>
    <comps>
      <li Class="Avir.Magic.HediffCompProperties_LifeRegen" />
    </comps>
    <stages>
      <li>
        <label>quickened</label>
        <statFactors><InjuryHealingFactor>1.6</InjuryHealingFactor></statFactors>
      </li>
      <li>
        <minSeverity>0.5</minSeverity>
        <label>deep</label>
        <statFactors><InjuryHealingFactor>2.2</InjuryHealingFactor></statFactors>
      </li>
      <li>
        <minSeverity>1</minSeverity>
        <label>saturated</label>
        <statFactors><InjuryHealingFactor>3</InjuryHealingFactor></statFactors>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>Avir_VitaFlow</defName>
    <label>store of life</label>
    <description>A store of life held in the core. It fades slowly, and what fades goes out of the mage: wounds close faster, and with the store above half the body fights sickness quicker.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.66, 0.82, 0.55)</defaultLabelColor>
    <isBad>false</isBad>
    <initialSeverity>0.01</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <stages>
      <li>
        <label>low</label>
        <statFactors><InjuryHealingFactor>1.2</InjuryHealingFactor></statFactors>
      </li>
      <li>
        <minSeverity>0.5</minSeverity>
        <label>full</label>
        <statFactors>
          <InjuryHealingFactor>1.4</InjuryHealingFactor>
          <ImmunityGainSpeed>1.15</ImmunityGainSpeed>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>Avir_LifeOverflow</defName>
    <label>bark and moss</label>
    <description>The store of life spilled over: bark and moss have crept over the hands. They fall away in a day or two.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.55, 0.62, 0.42)</defaultLabelColor>
    <isBad>true</isBad>
    <initialSeverity>0.05</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-0.5</severityPerDay>
      </li>
    </comps>
    <stages>
      <li>
        <capMods>
          <li><capacity>Manipulation</capacity><offset>-0.05</offset></li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.5</minSeverity>
        <label>thick</label>
        <capMods>
          <li><capacity>Manipulation</capacity><offset>-0.15</offset></li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <!-- Dead ground: Withering greys the soil for three days (MapComponent_TempTerrain). Placeholder: vanilla soil, greyed. -->
  <TerrainDef ParentName="NaturalTerrainBase">
    <defName>Avir_DeadGround</defName>
    <label>dead ground</label>
    <description>Soil Life has been drawn out of: grey, dry and crumbling. It comes back on its own in a few days.</description>
    <texturePath>Terrain/Surfaces/Soil</texturePath>
    <pollutedTexturePath>Terrain/Surfaces/SoilPolluted</pollutedTexturePath>
    <color>(0.62, 0.6, 0.56)</color>
    <edgeType>FadeRough</edgeType>
    <categoryType>Soil</categoryType>
    <renderPrecedence>342</renderPrecedence>
    <pathCost>2</pathCost>
    <fertility>0.2</fertility>
    <takeFootprints>true</takeFootprints>
    <generatedFilth>Filth_Dirt</generatedFilth>
    <statBases>
      <Beauty>-1</Beauty>
      <Cleanliness>-1.5</Cleanliness>
    </statBases>
    <affordances><li>Light</li><li>Medium</li><li>Heavy</li><li>GrowSoil</li><li>Diggable</li></affordances>
    <tags><li>Soil</li></tags>
  </TerrainDef>

  <!-- Emerald (Life + Earth): life sealed in a stone; carried and given. Placeholder graphic: vanilla jade, tinted. -->
  <ThingDef ParentName="ResourceBase">
    <defName>Avir_EmeraldOfLife</defName>
    <label>emerald of life</label>
    <description>Leaf, then stone, then an emerald full of life. A caster of the Emerald seals what dies near them into such stones; a Restoration of the Emerald draws on the stones near the spot and on the caster first. An empty stone crumbles.</description>
    <graphicData>
      <texPath>Things/Item/Resource/Jade</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <color>(90,200,120)</color>
    </graphicData>
    <stackLimit>1</stackLimit>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <Mass>0.4</Mass>
      <MarketValue>40</MarketValue>
      <Flammability>0</Flammability>
      <DeteriorationRate>0</DeteriorationRate>
    </statBases>
    <thingCategories><li>ResourcesRaw</li></thingCategories>
    <comps>
      <li Class="Avir.Magic.CompProperties_StoredLife"><max>200</max></li>
    </comps>
  </ThingDef>

  <!-- The meetings of Life as systems (LifePairs.cs) -->
  <HediffDef>
    <defName>Avir_WildSeed</defName>
    <label>living flame</label>
    <description>A spark of Wild Flame sown in the body. It sets its carrier alight and keeps flaring while it lives (about half an hour) - water does not put it out: in water the carrier steams, and the steam scalds them. Burning, the carrier runs in panic to the others nearest, and when it touches one it bursts - petals of green-gold fire - and leaps on into the one touched. A smouldering heart neither burns nor drives anyone: its bursts mend.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.85, 0.82, 0.3)</defaultLabelColor>
    <isBad>true</isBad>
    <maxSeverity>1</maxSeverity>
    <comps><li Class="Avir.Magic.HediffCompProperties_WildSeed" /></comps>
  </HediffDef>

  <HediffDef>
    <defName>Avir_BloodLock</defName>
    <label>blood held</label>
    <description>The blood in the body is held still by a mage of Blood, like water in a pool: no limb answers.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.75, 0.1, 0.12)</defaultLabelColor>
    <isBad>true</isBad>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears"><disappearsAfterTicks>360~360</disappearsAfterTicks><showRemainingTime>true</showRemainingTime></li>
    </comps>
    <stages>
      <li>
        <capMods>
          <li><capacity>Moving</capacity><setMax>0.05</setMax></li>
          <li><capacity>Manipulation</capacity><setMax>0.1</setMax></li>
          <li><capacity>Talking</capacity><setMax>0.1</setMax></li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>Avir_StoneCrust</defName>
    <label>stone crust</label>
    <description>Stone remembers life: a crust of green stone grows on the body. It slows and weighs down, and it is hard to cut through. It slows, hardens and quiets the body - hunger, speech, hands, legs - and the body takes the stone's colour. Full, it is a living statue: it stands (or lies, if caught lying) for days without falling, its hunger at a tenth; after three days the stone lets go. Short of full, it falls away slowly.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.3, 0.65, 0.45)</defaultLabelColor>
    <isBad>true</isBad>
    <initialSeverity>0.01</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <comps><li Class="Avir.Magic.HediffCompProperties_StoneCrust" /></comps>
    <stages>
      <li>
        <label>thin</label>
        <capMods><li><capacity>Moving</capacity><offset>-0.1</offset></li><li><capacity>Manipulation</capacity><offset>-0.05</offset></li></capMods>
        <statOffsets><ArmorRating_Sharp>0.1</ArmorRating_Sharp><ArmorRating_Blunt>0.1</ArmorRating_Blunt></statOffsets>
        <statFactors><HungerRateMultiplier>0.8</HungerRateMultiplier></statFactors>
      </li>
      <li>
        <minSeverity>0.4</minSeverity>
        <label>thick</label>
        <capMods><li><capacity>Moving</capacity><offset>-0.3</offset></li><li><capacity>Manipulation</capacity><offset>-0.25</offset></li><li><capacity>Talking</capacity><offset>-0.3</offset></li></capMods>
        <statOffsets><ArmorRating_Sharp>0.25</ArmorRating_Sharp><ArmorRating_Blunt>0.25</ArmorRating_Blunt></statOffsets>
        <statFactors><HungerRateMultiplier>0.5</HungerRateMultiplier></statFactors>
      </li>
      <li>
        <minSeverity>0.7</minSeverity>
        <label>heavy</label>
        <capMods><li><capacity>Moving</capacity><offset>-0.5</offset></li><li><capacity>Manipulation</capacity><offset>-0.5</offset></li><li><capacity>Talking</capacity><offset>-0.6</offset></li></capMods>
        <statOffsets><ArmorRating_Sharp>0.4</ArmorRating_Sharp><ArmorRating_Blunt>0.4</ArmorRating_Blunt></statOffsets>
        <statFactors><HungerRateMultiplier>0.25</HungerRateMultiplier></statFactors>
      </li>
      <li>
        <minSeverity>0.999</minSeverity>
        <label>a living statue</label>
        <capMods>
          <li><capacity>Moving</capacity><setMax>0.2</setMax></li>
          <li><capacity>Manipulation</capacity><setMax>0.05</setMax></li>
          <li><capacity>Talking</capacity><setMax>0.05</setMax></li>
        </capMods>
        <statOffsets><ArmorRating_Sharp>0.6</ArmorRating_Sharp><ArmorRating_Blunt>0.6</ArmorRating_Blunt></statOffsets>
        <statFactors><HungerRateMultiplier>0.1</HungerRateMultiplier></statFactors>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>Avir_StoneCocoon</defName>
    <label>stone cocoon</label>
    <description>A cocoon of living stone: the body inside does not move, little gets through, and it mends.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.3, 0.65, 0.45)</defaultLabelColor>
    <isBad>false</isBad>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears"><disappearsAfterTicks>600~600</disappearsAfterTicks><showRemainingTime>true</showRemainingTime></li>
    </comps>
    <stages>
      <li>
        <capMods><li><capacity>Moving</capacity><setMax>0</setMax></li></capMods>
        <statFactors><IncomingDamageFactor>0.25</IncomingDamageFactor><InjuryHealingFactor>3</InjuryHealingFactor></statFactors>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>Avir_FertilePoison</defName>
    <label>fertile poison</label>
    <description>The poison of a Pestilence fog: not a toxin, but life gone too rich. It grows fast while one stands in the fog and keeps growing, slower, after. At its end the legs stop answering for days (paralytic abasia).</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.72, 0.78, 0.32)</defaultLabelColor>
    <isBad>true</isBad>
    <initialSeverity>0.01</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <comps><li Class="Avir.Magic.HediffCompProperties_FertilePoison" /></comps>
    <stages>
      <li><label>faint</label></li>
      <li><minSeverity>0.5</minSeverity><label>spreading</label><capMods><li><capacity>Moving</capacity><offset>-0.1</offset></li></capMods></li>
      <li><minSeverity>0.8</minSeverity><label>deep</label><capMods><li><capacity>Moving</capacity><offset>-0.25</offset></li></capMods></li>
    </stages>
  </HediffDef>

  <!-- the fallback when Royalty's paralytic abasia is not there -->
  <HediffDef>
    <defName>Avir_Abasia</defName>
    <label>paralytic abasia</label>
    <description>The legs do not answer. It passes in a few days.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears"><disappearsAfterTicks>180000~240000</disappearsAfterTicks><showRemainingTime>true</showRemainingTime></li>
    </comps>
    <stages><li><capMods><li><capacity>Moving</capacity><setMax>0.1</setMax></li></capMods></li></stages>
  </HediffDef>
  <!-- Emerald plants: what the Emerald's Transmutation leaves of a plant. The picture is taken from the plant and tinted
       (EmeraldPlant.Graphic); this graphic is only a fallback. Fixed worth, no quality, no art; light and portable. -->
  <ThingDef Name="Avir_EmeraldPlantBase" Abstract="True">
    <thingClass>Avir.Magic.EmeraldPlant</thingClass>
    <category>Building</category>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <selectable>true</selectable>
    <rotatable>false</rotatable>
    <useHitPoints>true</useHitPoints>
    <drawerType>MapMeshAndRealTime</drawerType>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories><li>BuildingsArt</li></thingCategories>
    <tradeability>Sellable</tradeability>
    <graphicData>
      <texPath>Things/Item/Resource/Jade/Jade_a</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <color>(90,200,120)</color>
    </graphicData>
    <building><isInert>true</isInert></building>
    <description>A plant turned to green stone by a caster of the Emerald: leaf, then stone. Its life went into an emerald; what is left is fair to look at, and can be carried and set anywhere. A caster of the Emerald can let the plant go again.</description>
  </ThingDef>
  <ThingDef ParentName="Avir_EmeraldPlantBase">
    <defName>Avir_EmeraldSprig</defName>
    <label>emerald sprig</label>
    <fillPercent>0.15</fillPercent>
    <statBases><MaxHitPoints>60</MaxHitPoints><Beauty>8</Beauty><MarketValue>80</MarketValue><Mass>1</Mass><Flammability>0</Flammability></statBases>
  </ThingDef>
  <ThingDef ParentName="Avir_EmeraldPlantBase">
    <defName>Avir_EmeraldBush</defName>
    <label>emerald bush</label>
    <fillPercent>0.25</fillPercent>
    <statBases><MaxHitPoints>120</MaxHitPoints><Beauty>16</Beauty><MarketValue>250</MarketValue><Mass>3</Mass><Flammability>0</Flammability></statBases>
  </ThingDef>
  <ThingDef ParentName="Avir_EmeraldPlantBase">
    <defName>Avir_EmeraldTree</defName>
    <label>emerald tree</label>
    <fillPercent>0.35</fillPercent>
    <statBases><MaxHitPoints>300</MaxHitPoints><Beauty>30</Beauty><MarketValue>600</MarketValue><Mass>8</Mass><Flammability>0</Flammability></statBases>
  </ThingDef>
</Defs>
