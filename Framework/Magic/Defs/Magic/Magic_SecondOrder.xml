<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- SECOND-ORDER MEETINGS (Source/Avir/Magic/SecondOrder.cs) -->
  <HediffDef>
    <defName>Avir_HeatTrap</defName>
    <label>heat trapped</label>
    <description>Dry heat with nowhere to go: under sealed armour the body cooks twice as fast.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.8, 0.6, 0.4)</defaultLabelColor>
    <isBad>true</isBad>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>600~600</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <label>trapped</label>
      </li>
    </stages>
  </HediffDef>
  <HediffDef>
    <defName>Avir_Dried</defName>
    <label>dried</label>
    <description>The inferno has dried this body: no soaking, no water ward, for a while.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(1, 0.8, 0.5)</defaultLabelColor>
    <isBad>false</isBad>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>600~600</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <label>dry</label>
      </li>
    </stages>
  </HediffDef>
  <HediffDef>
    <defName>Avir_LavaMired</defName>
    <label>stuck in lava</label>
    <description>Feet caught in running lava: slow, and burning.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.8, 0.6, 0.4)</defaultLabelColor>
    <isBad>true</isBad>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>600~600</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <capMods><li><capacity>Moving</capacity><offset>-0.4</offset></li></capMods>
      </li>
    </stages>
  </HediffDef>
  <HediffDef>
    <defName>Avir_Pillared</defName>
    <label>on a basalt pillar</label>
    <description>Raised high on a pillar of basalt the volcano pushed up: no way down until it falls - and then a hard fall.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.8, 0.6, 0.4)</defaultLabelColor>
    <isBad>true</isBad>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="Avir.Magic.HediffCompProperties_Pillar" />
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>600~600</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <capMods><li><capacity>Moving</capacity><setMax>0.05</setMax></li></capMods>
      </li>
    </stages>
  </HediffDef>
  <HediffDef>
    <defName>Avir_Ashen</defName>
    <label>ash in the eyes</label>
    <description>Scorching ash: hard to see and to breathe.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.5, 0.5, 0.5)</defaultLabelColor>
    <isBad>true</isBad>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>600~600</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <capMods><li><capacity>Sight</capacity><offset>-0.3</offset></li><li><capacity>Breathing</capacity><offset>-0.15</offset></li></capMods>
      </li>
    </stages>
  </HediffDef>
  <HediffDef>
    <defName>Avir_Updraft</defName>
    <label>warm updraft</label>
    <description>A rising warm current: lighter on the feet and in the air.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(1, 0.85, 0.6)</defaultLabelColor>
    <isBad>false</isBad>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>600~600</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <statOffsets><MoveSpeed>0.6</MoveSpeed></statOffsets>
      </li>
    </stages>
  </HediffDef>
  <HediffDef>
    <defName>Avir_Parched</defName>
    <label>parched</label>
    <description>The dry wind has drawn the water out: dull and slow.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.8, 0.6, 0.4)</defaultLabelColor>
    <isBad>true</isBad>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>600~600</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <capMods><li><capacity>Consciousness</capacity><offset>-0.1</offset></li><li><capacity>Moving</capacity><offset>-0.1</offset></li></capMods>
      </li>
    </stages>
  </HediffDef>
  <HediffDef>
    <defName>Avir_Silted</defName>
    <label>silted joints</label>
    <description>Silt in the joints - of the body, of the armour, of the bionics.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.5, 0.45, 0.35)</defaultLabelColor>
    <isBad>true</isBad>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>600~600</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <capMods><li><capacity>Moving</capacity><offset>-0.25</offset></li><li><capacity>Manipulation</capacity><offset>-0.1</offset></li></capMods>
      </li>
    </stages>
  </HediffDef>
  <HediffDef>
    <defName>Avir_SiltBound</defName>
    <label>set in silt</label>
    <description>The silt has set round the legs: held fast until it dries.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.5, 0.45, 0.35)</defaultLabelColor>
    <isBad>true</isBad>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>600~600</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <capMods><li><capacity>Moving</capacity><setMax>0.1</setMax></li></capMods>
      </li>
    </stages>
  </HediffDef>
  <HediffDef>
    <defName>Avir_MarshLungs</defName>
    <label>marsh gas in the lungs</label>
    <description>Marsh gas pressing on the lungs: not deadly, but the head swims. A gas mask or a sealed suit keeps it out.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.55, 0.65, 0.35)</defaultLabelColor>
    <isBad>true</isBad>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>600~600</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <capMods><li><capacity>Consciousness</capacity><offset>-0.15</offset></li><li><capacity>Breathing</capacity><offset>-0.2</offset></li></capMods>
      </li>
    </stages>
  </HediffDef>
  <HediffDef>
    <defName>Avir_Abraded</defName>
    <label>worn down</label>
    <description>The emery wind has worn this one's armour and clothes thin.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.8, 0.7, 0.5)</defaultLabelColor>
    <isBad>true</isBad>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>600~600</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <label>worn</label>
      </li>
    </stages>
  </HediffDef>
  <HediffDef>
    <defName>Avir_Honed</defName>
    <label>honed blade</label>
    <description>An emery aura has honed this one's blade.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.85, 0.85, 0.7)</defaultLabelColor>
    <isBad>false</isBad>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>600~600</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <statFactors><MeleeDamageFactor>1.2</MeleeDamageFactor></statFactors>
      </li>
    </stages>
  </HediffDef>
  <HediffDef>
    <defName>Avir_BurningSand</defName>
    <label>burning sand</label>
    <description>Hot grains stuck to the body: they burn until water washes them off.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(1, 0.55, 0.25)</defaultLabelColor>
    <isBad>true</isBad>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="Avir.Magic.HediffCompProperties_BurningSand" />
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>600~600</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <painOffset>0.1</painOffset>
      </li>
    </stages>
  </HediffDef>
  <HediffDef>
    <defName>Avir_Glitched</defName>
    <label>bionics glitching</label>
    <description>A discharge through the bionics: they stutter for a while.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.6, 0.7, 1)</defaultLabelColor>
    <isBad>true</isBad>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>600~600</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <capMods><li><capacity>Manipulation</capacity><offset>-0.15</offset></li><li><capacity>Moving</capacity><offset>-0.15</offset></li></capMods>
      </li>
    </stages>
  </HediffDef>
  <HediffDef>
    <defName>Avir_SiltJammed</defName>
    <label>gun choked with silt</label>
    <description>Silt in the action: a ranged weapon of industrial make or older does not fire until it is cleared. Spacer and ultratech arms shrug it off.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.5, 0.45, 0.35)</defaultLabelColor>
    <isBad>true</isBad>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>600~600</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
  </HediffDef>
  <HediffDef>
    <defName>Avir_Clayed</defName>
    <label>clay-bound</label>
    <description>Clay over arms and legs; as it sets it holds the body fast. It crumbles away in time.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.7, 0.45, 0.3)</defaultLabelColor>
    <isBad>true</isBad>
    <initialSeverity>0.3</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay"><severityPerDay>-3</severityPerDay></li>
    </comps>
    <stages>
      <li><label>sticky</label><capMods><li><capacity>Moving</capacity><offset>-0.3</offset></li><li><capacity>Manipulation</capacity><offset>-0.2</offset></li></capMods></li>
      <li><minSeverity>0.6</minSeverity><label>set</label><capMods><li><capacity>Moving</capacity><setMax>0.1</setMax></li><li><capacity>Manipulation</capacity><offset>-0.5</offset></li></capMods></li>
    </stages>
  </HediffDef>
  <ThoughtDef>
    <defName>Avir_SawRainbow</defName>
    <durationDays>1</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>saw a rainbow</label>
        <description>A rainbow, made by a caster. Silly, maybe. Still lovely.</description>
        <baseMoodEffect>4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
</Defs>
