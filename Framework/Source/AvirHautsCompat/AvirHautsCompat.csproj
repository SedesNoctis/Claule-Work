<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />

  <PropertyGroup>
    <!-- Same two lines as Avir.csproj - unchanged, no need to edit these again. -->
    <RimWorldManaged>D:\SteamNew\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldManaged>
    <HarmonyDll>D:\SteamNew\steamapps\workshop\content\294100\2009463077\1.6\Assemblies\0Harmony.dll</HarmonyDll>
  </PropertyGroup>

  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <OutputType>Library</OutputType>
    <RootNamespace>AvirHautsCompat</RootNamespace>
    <AssemblyName>AvirHautsCompat</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <LangVersion>latest</LangVersion>
    <!-- Source/AvirHautsCompat/ -> Compat/HautsFramework/Assemblies/, matching how
         AvirRJW and AvirGriffinColors are wired. -->
    <OutputPath>..\..\Compat\HautsFramework\Assemblies\</OutputPath>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Optimize>true</Optimize>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManaged)\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyDll)</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- No HautsFramework.dll reference: TraitGrantedStuff is only used from XML
         (Class="HautsFramework.TraitGrantedStuff"), which resolves at runtime once that
         assembly is loaded - no compile-time link needed. -->
    <!-- Avir.dll IS referenced directly, unlike Hauts/CE - it's not an optional external mod,
         it's the mod this assembly ships inside, so there's no soft-dependency reason to avoid
         it. Needed for Avir.Gene_ArcaneHunger. BUILD Avir.csproj FIRST - this HintPath reads its
         output, and won't resolve if Avir.dll hasn't been produced yet. -->
    <Reference Include="Avir">
      <HintPath>..\..\Assemblies\Avir.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="System" />
    <Reference Include="System.Core" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="**\*.cs" Exclude="obj\**\*.cs;bin\**\*.cs" />
  </ItemGroup>

  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
